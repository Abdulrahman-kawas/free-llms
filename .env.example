# Copy to .env and fill what you have. A provider without its key is simply skipped.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=

# https://open.bigmodel.cn → API keys (or z.ai, then change base_url in providers.toml)
ZAI_API_KEY=

# https://ollama.com/settings/keys
OLLAMA_API_KEY=

# https://dash.cloudflare.com → AI → Workers AI → Use REST API (needs both)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: require this key from clients of `free-llm serve`
FREE_LLM_PROXY_KEY=
